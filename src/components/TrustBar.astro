---
import Icon from "./Icon.astro";

const points = [
  "Estimation simple & transparente",
  "Expertise locale à Genève",
  "Accompagnement discret",
];
---

<div class="trust-bar">
  <div class="container trust-bar-row">
    {points.map((point) => (
      <div class="trust-point">
        <Icon name="check-circle" size={20} />
        <span>{point}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .trust-bar {
    background: var(--color-green-900);
    color: var(--color-on-dark);
  }

  .trust-bar-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }

  @media (min-width: 768px) {
    .trust-bar-row {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-8);
    }
  }

  .trust-point {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  .trust-point :global(svg) {
    color: var(--color-gold);
    flex-shrink: 0;
  }
</style>
