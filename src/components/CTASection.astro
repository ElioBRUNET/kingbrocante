---
type Props = {
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
};

const { title, text, ctaLabel, ctaHref } = Astro.props;
---

<section class="cta-section">
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a href={ctaHref} class="btn btn-primary cta-btn">{ctaLabel}</a>
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--space-6);
  }

  .cta-inner {
    background: var(--color-gold);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-9) var(--space-9);
    }
  }

  .cta-copy h2 {
    color: var(--color-green-900);
    margin-bottom: var(--space-3);
  }

  .cta-copy p {
    color: var(--color-green-900);
    opacity: 0.85;
    font-size: var(--fs-md);
    max-width: 46ch;
  }

  .cta-btn {
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>
