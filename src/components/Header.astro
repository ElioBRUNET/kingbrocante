---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import Icon from "./Icon.astro";
import { mainNav } from "../data/nav";
import { business } from "../data/business";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container header-container header-row">
    <a href="/" class="logo-link" aria-label="King Brocante — retour à l'accueil">
      <Image src={logo} alt="King Brocante" width={220} height={110} class="logo-img" loading="eager" />
    </a>

    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {mainNav.map((item) => {
          const itemPath = item.href.replace(/\/$/, "") || "/";
          const isActive = itemPath === currentPath;
          return (
            <li>
              <a href={item.href} aria-current={isActive ? "page" : undefined}>{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={business.kingCleaningUrl} class="king-cleaning-link" target="_blank" rel="noopener">
        King Cleaning
      </a>
      <a href="/contact#estimation" class="btn btn-primary header-cta">
        {business.primaryCta}
      </a>
      <button type="button" class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav" id="menu-toggle">
        <Icon name="menu" size={26} class="icon-menu" />
        <Icon name="close" size={26} class="icon-close" />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Navigation mobile">
      <ul>
        {mainNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href={business.kingCleaningUrl} target="_blank" rel="noopener">King Cleaning ↗</a></li>
      </ul>
    </nav>
    <a href="/contact#estimation" class="btn btn-primary btn-block">{business.primaryCta}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-container {
    max-width: 1360px;
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 0.75rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    width: 132px;
    height: auto;
  }

  @media (min-width: 1024px) {
    .logo-img {
      width: 160px;
    }
  }

  .main-nav {
    display: none;
  }

  .main-nav ul {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: nowrap;
  }

  .main-nav a {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .main-nav a:hover,
  .main-nav a[aria-current="page"] {
    color: var(--color-green);
    border-color: var(--color-gold);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .king-cleaning-link {
    display: none;
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    color: var(--color-body-light);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.8rem;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .king-cleaning-link:hover {
    color: var(--color-green);
    border-color: var(--color-green);
  }

  .header-cta {
    display: none;
    padding: 0.75rem 1.25rem;
    min-height: 44px;
    font-size: var(--fs-xs);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: var(--color-white);
    color: var(--color-ink);
  }

  .menu-toggle :global(.icon-close) {
    display: none;
  }

  .menu-toggle[data-state="open"] :global(.icon-menu) {
    display: none;
  }

  .menu-toggle[data-state="open"] :global(.icon-close) {
    display: block;
  }

  .mobile-nav {
    border-top: 1px solid var(--color-border);
    background: var(--color-white);
    padding: var(--space-5) var(--container-pad) var(--space-6);
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-5);
  }

  .mobile-nav a {
    display: block;
    padding: 0.9rem 0.25rem;
    font-size: var(--fs-md);
    font-weight: var(--fw-semibold);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 1180px) {
    .main-nav {
      display: block;
    }
    .king-cleaning-link {
      display: inline-flex;
    }
    .header-cta {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  if (toggle && mobileNav) {
    toggle.addEventListener("click", () => {
      const willOpen = mobileNav.hidden;
      mobileNav.hidden = !willOpen;
      toggle.setAttribute("aria-expanded", String(willOpen));
      toggle.setAttribute("aria-label", willOpen ? "Fermer le menu" : "Ouvrir le menu");
      toggle.dataset.state = willOpen ? "open" : "closed";
    });

    // Close mobile nav when a link is clicked
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileNav.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
