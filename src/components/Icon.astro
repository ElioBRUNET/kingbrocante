---
type Props = {
  name:
    | "phone"
    | "mail"
    | "map-pin"
    | "camera"
    | "upload"
    | "check"
    | "check-circle"
    | "chevron-down"
    | "arrow-right"
    | "menu"
    | "close"
    | "facebook"
    | "instagram"
    | "x-circle"
    | "shield"
    | "sparkles"
    | "compass"
    | "clock";
  size?: number;
  strokeWidth?: number;
  class?: string;
};

const { name, size = 24, strokeWidth = 1.8, class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === "phone" && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
  )}
  {name === "mail" && (<>
    <rect x="2" y="4" width="20" height="16" rx="2"/>
    <path d="m22 6-10 7L2 6"/>
  </>)}
  {name === "map-pin" && (<>
    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
    <circle cx="12" cy="10" r="3"/>
  </>)}
  {name === "camera" && (<>
    <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3Z"/>
    <circle cx="12" cy="13" r="3.5"/>
  </>)}
  {name === "upload" && (<>
    <path d="M12 16V4"/>
    <path d="m6 9 6-6 6 6"/>
    <path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>
  </>)}
  {name === "check" && <path d="M20 6 9 17l-5-5"/>}
  {name === "check-circle" && (<>
    <circle cx="12" cy="12" r="9"/>
    <path d="m8.5 12.5 2.3 2.3 4.7-5.1"/>
  </>)}
  {name === "chevron-down" && <path d="m6 9 6 6 6-6"/>}
  {name === "arrow-right" && (<>
    <path d="M5 12h14"/>
    <path d="m13 6 6 6-6 6"/>
  </>)}
  {name === "menu" && (<>
    <path d="M4 7h16"/>
    <path d="M4 12h16"/>
    <path d="M4 17h16"/>
  </>)}
  {name === "close" && (<>
    <path d="m6 6 12 12"/>
    <path d="m18 6-12 12"/>
  </>)}
  {name === "facebook" && (
    <path d="M14 9h3V6h-3a4 4 0 0 0-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1Z"/>
  )}
  {name === "instagram" && (<>
    <rect x="3" y="3" width="18" height="18" rx="5"/>
    <circle cx="12" cy="12" r="4"/>
    <circle cx="17.5" cy="6.5" r="1"/>
  </>)}
  {name === "x-circle" && (<>
    <circle cx="12" cy="12" r="9"/>
    <path d="m9 9 6 6"/>
    <path d="m15 9-6 6"/>
  </>)}
  {name === "shield" && (
    <path d="M12 3 4 6v6c0 5 3.5 7.5 8 9 4.5-1.5 8-4 8-9V6l-8-3Z"/>
  )}
  {name === "sparkles" && (<>
    <path d="M12 3v4"/>
    <path d="M12 17v4"/>
    <path d="M3 12h4"/>
    <path d="M17 12h4"/>
    <path d="m5.6 5.6 2.8 2.8"/>
    <path d="m15.6 15.6 2.8 2.8"/>
    <path d="m18.4 5.6-2.8 2.8"/>
    <path d="m8.4 15.6-2.8 2.8"/>
  </>)}
  {name === "compass" && (<>
    <circle cx="12" cy="12" r="9"/>
    <path d="m15 9-1.5 4.5L9 15l1.5-4.5Z"/>
  </>)}
  {name === "clock" && (<>
    <circle cx="12" cy="12" r="9"/>
    <path d="M12 7v5l3 3"/>
  </>)}
</svg>
