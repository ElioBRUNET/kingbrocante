---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import Icon from "./Icon.astro";
import { footerServiceLinks } from "../data/nav";
import { business } from "../data/business";

const year = 2026;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={logo} alt="King Brocante" width={200} height={100} class="footer-logo" />
      <p>
        Estimation, valorisation et seconde vie d'objets à {business.city} : mobilier,
        bijoux, montres, argenterie, tableaux et objets anciens.
      </p>
      <div class="footer-social">
        {business.socialLinks.facebook && (
          <a href={business.socialLinks.facebook} aria-label="Facebook King Brocante" target="_blank" rel="noopener">
            <Icon name="facebook" size={20} />
          </a>
        )}
        {business.socialLinks.instagram && (
          <a href={business.socialLinks.instagram} aria-label="Instagram King Brocante" target="_blank" rel="noopener">
            <Icon name="instagram" size={20} />
          </a>
        )}
      </div>
    </div>

    <nav class="footer-col" aria-label="Services">
      <h3>Services</h3>
      <ul>
        {footerServiceLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <h3>Contact</h3>
      <ul>
        {business.phone && (
          <li class="footer-meta-item">
            <Icon name="phone" size={18} />
            <span>{business.phone}</span>
          </li>
        )}
        {business.email && (
          <li class="footer-meta-item">
            <Icon name="mail" size={18} />
            <span>{business.email}</span>
          </li>
        )}
        {business.streetAddress && (
          <li class="footer-meta-item">
            <Icon name="map-pin" size={18} />
            <span>{business.streetAddress}, {business.postalCode} {business.city}</span>
          </li>
        )}
        {business.openingHoursDisplay && (
          <li class="footer-meta-item">
            <Icon name="clock" size={18} />
            <span>{business.openingHoursDisplay}</span>
          </li>
        )}
      </ul>
    </div>

    <div class="footer-col">
      <h3>Réseau King</h3>
      <ul>
        <li>
          <a href={business.kingCleaningUrl} target="_blank" rel="noopener">King Cleaning ↗</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} King Brocante. Tous droits réservés.</p>
    <div class="footer-legal-links">
      <a href="/politique-de-confidentialite">Politique de confidentialité</a>
      <a href="/mentions-legales">Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-green-900);
    color: var(--color-on-dark-muted);
    padding-block: var(--space-9) var(--space-6);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .footer-brand p {
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    max-width: 32ch;
  }

  .footer-logo {
    width: 150px;
    height: auto;
    filter: brightness(0) invert(1) opacity(0.92);
  }

  .footer-social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(243, 241, 234, 0.08);
    color: var(--color-on-dark);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .footer-social a:hover {
    background: var(--color-gold);
    color: var(--color-green-900);
  }

  .footer-col h3 {
    color: var(--color-on-dark);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-col a {
    font-size: var(--fs-sm);
    transition: color var(--transition-fast);
  }

  .footer-col a:hover {
    color: var(--color-gold);
  }

  .footer-meta-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--fs-sm);
  }

  .footer-meta-item :global(svg) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-gold);
  }

  .footer-bottom {
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(243, 241, 234, 0.12);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--fs-xs);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-legal-links {
    display: flex;
    gap: var(--space-5);
  }

  .footer-legal-links a:hover {
    color: var(--color-gold);
  }
</style>
