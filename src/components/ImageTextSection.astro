---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  eyebrow?: string;
  title: string;
  paragraphs: string[];
  ctaLabel?: string;
  ctaHref?: string;
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
};

const { eyebrow, title, paragraphs, ctaLabel, ctaHref, image, imageAlt, reverse = false } = Astro.props;
---

<div class:list={["image-text", { reverse }]}>
  <div class="image-text-media">
    <Image
      src={image}
      alt={imageAlt}
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 520px, 90vw"
      width={800}
      height={900}
      loading="lazy"
    />
  </div>
  <div class="image-text-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {paragraphs.map((p) => <p class="text-lead">{p}</p>)}
    {ctaLabel && ctaHref && (
      <a href={ctaHref} class="btn btn-primary">{ctaLabel}</a>
    )}
  </div>
</div>

<style>
  .image-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .image-text {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-9);
    }
    .image-text.reverse .image-text-media {
      order: 2;
    }
  }

  .image-text-media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .image-text-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 520px;
  }

  .image-text-copy h2 {
    margin-block: var(--space-2) var(--space-4);
  }

  .image-text-copy .text-lead {
    margin-bottom: var(--space-4);
  }

  .image-text-copy .btn {
    margin-top: var(--space-2);
  }
</style>
