---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PillarList from "../components/PillarList.astro";
import ProcessSection from "../components/ProcessSection.astro";
import ObjectGrid from "../components/ObjectGrid.astro";
import ImageTextSection from "../components/ImageTextSection.astro";
import EstimationForm from "../components/EstimationForm.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";
import { homeCategories } from "../data/categories";
import { publishedFaqItems } from "../data/faq";
import { breadcrumbSchema, serviceSchema } from "../lib/schema";
import examImage from "../assets/images/objets-examen.jpg";

const crumbs = [
  { name: "Accueil", path: "/" },
  { name: "Estimation & valorisation", path: "/estimation-valorisation" },
];

const estimationFaq = publishedFaqItems.filter((item) =>
  [
    "Quels types d'objets pouvez-vous estimer ?",
    "Comment faire estimer un objet ?",
    "Puis-je envoyer des photos depuis mon téléphone ?",
    "L'estimation est-elle gratuite ?",
    "Que faire si je ne connais rien sur l'objet ?",
  ].includes(item.question)
);

const helpPoints = [
  {
    icon: "camera" as const,
    title: "Des photos nettes",
    text: "Une vue d'ensemble et quelques détails (marques, signatures, état) suffisent souvent.",
  },
  {
    icon: "compass" as const,
    title: "La provenance",
    text: "Héritage, achat, brocante : le contexte aide à mieux situer l'objet.",
  },
  {
    icon: "sparkles" as const,
    title: "L'état général",
    text: "Usures, restaurations, accidents visibles : tout détail est utile.",
  },
  {
    icon: "shield" as const,
    title: "Les dimensions",
    text: "Taille, poids approximatif ou toute inscription visible sur l'objet.",
  },
];
---

<BaseLayout
  title="Estimation & valorisation d'objets à Genève"
  description="Comment faire estimer un objet à Genève avec King Brocante : mobilier ancien, bijoux, montres, argenterie, tableaux. Envoyez vos photos, recevez un premier avis."
  path="/estimation-valorisation"
  structuredData={[
    breadcrumbSchema(crumbs),
    serviceSchema({
      name: "Estimation & valorisation d'objets",
      description:
        "Identification, estimation et accompagnement à la valorisation d'objets anciens, de mobilier, bijoux, montres, argenterie et œuvres à Genève.",
      path: "/estimation-valorisation",
    }),
  ]}
>
  <PageIntro
    eyebrow="Nos services"
    title="Estimation & valorisation d'objets"
    lead="Identifier, comprendre et valoriser un objet : King Brocante vous accompagne à chaque étape, de la première photo à la meilleure seconde vie possible."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container container-prose">
      <SectionHeading
        eyebrow="Ce que nous entendons par estimation"
        title="Une démarche d'<em>estimation</em>, pas de rachat"
      />
      <p class="text-lead">
        Faire estimer un objet chez King Brocante, c'est avant tout comprendre ce que
        vous possédez : son origine probable, son état, et les pistes de valorisation
        qui s'offrent à vous. Notre rôle est de vous éclairer et de vous accompagner
        dans vos choix — pas de vous pousser vers une vente.
      </p>
      <p class="text-lead">
        Selon les objets et les situations, la valorisation peut prendre différentes
        formes : conservation, don, mise en valeur, ou orientation vers la solution la
        plus adaptée à votre objet.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading
        eyebrow="Notre méthode"
        title="Comment se déroule une estimation"
        align="center"
      />
      <ProcessSection />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Nous aider à mieux vous répondre"
        title="Ce qui facilite une première analyse"
        lead="Vous n'avez pas besoin d'être un expert : ces quelques éléments suffisent à démarrer."
      />
      <PillarList pillars={helpPoints} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <ImageTextSection
        eyebrow="Un regard attentif"
        title="Nous prenons le temps d'examiner chaque objet"
        paragraphs={[
          "Chaque objet a ses particularités : une signature, une marque, une réparation ancienne. Ce sont souvent ces détails qui orientent l'estimation.",
          "C'est pourquoi la qualité de vos photos et les informations que vous nous transmettez font toute la différence dans la première analyse.",
        ]}
        image={examImage}
        imageAlt="Examen attentif d'objets anciens avant estimation"
        reverse
      />
    </div>
  </section>

  <section class="section" aria-labelledby="categories-heading">
    <div class="container">
      <SectionHeading
        eyebrow="Catégories concernées"
        title="Des objets que nous accompagnons régulièrement"
      />
      <ObjectGrid categories={homeCategories} />
      <div class="categories-cta">
        <a href="/objets" class="btn btn-outline">Voir toutes les catégories</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="estimation-section">
    <div class="container">
      <EstimationForm />
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <SectionHeading eyebrow="Questions fréquentes" title="Vos questions, nos réponses" />
      <FAQAccordion items={estimationFaq} />
    </div>
  </section>

  <CTASection
    title="Prêt à faire estimer votre objet ?"
    text="Envoyez-nous quelques photos et informations, où que vous soyez à Genève."
    ctaLabel="Faire estimer mon objet →"
    ctaHref="/contact#estimation"
  />
</BaseLayout>

<style>
  .container-prose {
    max-width: 760px;
  }

  .container-prose .text-lead {
    margin-bottom: var(--space-4);
  }

  .container-narrow {
    max-width: 860px;
  }

  .categories-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-8);
  }
</style>
